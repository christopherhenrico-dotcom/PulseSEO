# PulseSEO Environment Variables
# Copy to .env and fill in your values

# Google PageSpeed Insights API (for page speed audits)
# Get free key: https://developers.google.com/speed/docs/insights/v5/get-started
# Without this, page speed features will use simulated data
VITE_PAGESPEED_API_KEY=your_google_pagespeed_api_key_here

# Jina AI (for website scraping) - works without key on free tier
# Optional: add key for higher rate limits
VITE_JINA_API_KEY=

# Transformers.js runs locally (webgpu/cpu) - no key needed
VITE_AI_DEVICE=webgpu
