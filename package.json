{
  "name": "pulseseo-desktop",
  "version": "1.0.0",
  "description": "PulseSEO Desktop - Enterprise SEO Audit Platform",
  "main": "electron/main.js",
  "author": "PulseSEO Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder --win",
    "electron": "electron .",
    "electron:dev": "npm run build && electron ."
  },
  "build": {
    "appId": "com.pulseseo.app",
    "productName": "PulseSEO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "models/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@xenova/transformers": "^2.17.2",
    "electron-log": "^5.1.7",
    "electron-store": "^8.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.9",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.1",
    "vite": "^6.4.1"
  }
}
