{
  "name": "pulseseo-desktop",
  "version": "1.0.0",
  "description": "PulseSEO Desktop - Enterprise SEO Audit Platform",
  "main": "electron/main.js",
  "author": "PulseSEO Team",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder --win",
    "electron": "electron .",
    "electron:dev": "npm run build && electron ."
  },
  "build": {
    "appId": "com.pulseseo.app",
    "productName": "PulseSEO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "models/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@xenova/transformers": "^2.17.2",
    "electron-log": "^5.1.7",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  }
}
